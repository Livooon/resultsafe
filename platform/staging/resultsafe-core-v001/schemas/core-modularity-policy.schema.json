{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:uuid:01a01d86-7c24-7a3e-8f7c-a367ff5ffdc8",
  "title": "ResultSafe Core modularity policy",
  "type": "object",
  "allOf": [
    { "$ref": "urn:uuid:01a01af6-9801-778a-89d8-17777b859f3b" },
    {
      "type": "object",
      "properties": {
        "document_key": { "const": "core-modularity-policy" },
        "document_type": { "const": "policy" },
        "schema_ref": { "const": "urn:uuid:01a01d86-7c24-7a3e-8f7c-a367ff5ffdc8" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["package_name", "source_hygiene", "invariants", "artifact_path_derivation", "qualification_rule"],
          "properties": {
            "package_name": { "const": "@resultsafe/core-fp-result" },
            "source_hygiene": {
              "type": "object",
              "additionalProperties": false,
              "required": ["governed_roots", "forbidden_colocated_generated_suffixes", "ignored_local_only_paths", "required_gitignore_rules", "source_snapshot_rule", "enforcement", "qualification_gate", "evidence_owner"],
              "properties": {
                "governed_roots": {
                  "type": "array", "minItems": 1, "maxItems": 1,
                  "prefixItems": [{ "const": "packages/core/fp/result/src" }], "items": false
                },
                "forbidden_colocated_generated_suffixes": {
                  "type": "array", "minItems": 3, "maxItems": 3,
                  "prefixItems": [{ "const": ".js" }, { "const": ".d.ts" }, { "const": ".d.ts.map" }], "items": false
                },
                "ignored_local_only_paths": {
                  "type": "array", "minItems": 3, "maxItems": 3,
                  "prefixItems": [{ "const": "notes/" }, { "const": "platform/candidates/" }, { "const": ".resultsafe-candidates/" }], "items": false
                },
                "required_gitignore_rules": {
                  "type": "array", "minItems": 6, "maxItems": 6,
                  "prefixItems": [
                    { "$ref": "#/$defs/resultJsIgnore" }, { "$ref": "#/$defs/resultDtsIgnore" }, { "$ref": "#/$defs/resultDtsMapIgnore" },
                    { "$ref": "#/$defs/notesIgnore" }, { "$ref": "#/$defs/platformCandidatesIgnore" }, { "$ref": "#/$defs/resultsafeCandidatesIgnore" }
                  ],
                  "items": false
                },
                "source_snapshot_rule": {
                  "type": "object", "additionalProperties": false,
                  "required": ["forbidden_generated_outputs", "local_only_paths"],
                  "properties": {
                    "forbidden_generated_outputs": { "const": "MUST_NOT_CONTAIN" },
                    "local_only_paths": { "const": "MUST_NOT_CONTAIN" }
                  }
                },
                "enforcement": { "const": "NORMATIVE_PRE_SOURCE_SNAPSHOT" },
                "qualification_gate": { "const": "core-modularity" },
                "evidence_owner": { "const": "core-modularity" }
              }
            },
            "invariants": {
              "type": "array",
              "minItems": 8,
              "maxItems": 8,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["invariant_key", "requirement", "current_status", "atomic_evidence"],
                "properties": {
                  "invariant_key": { "enum": ["zero-runtime-dependencies", "every-public-module-direct-import", "root-plus-subpaths", "no-mandatory-codecs-adapters-storage-runtime-registry", "no-import-side-effects", "optional-integrations-separate-packages", "packed-artifact-proof", "preserve-result-surface"] },
                  "requirement": { "type": "string", "minLength": 20 },
                  "current_status": { "const": "QUALIFIED_LOCAL_SNAPSHOT" },
                  "observation": { "type": "string", "minLength": 10 },
                  "atomic_evidence": { "$ref": "#/$defs/atomicEvidence" }
                }
              },
              "uniqueItems": true
            },
            "artifact_path_derivation": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source_rule", "source_manifest_rule", "packed_manifest_rule", "root_exception", "umd_rule"],
              "properties": {
                "source_rule": { "type": "string", "minLength": 20 },
                "source_manifest_rule": { "type": "string", "minLength": 20 },
                "packed_manifest_rule": { "type": "string", "minLength": 20 },
                "root_exception": { "type": "string", "minLength": 20 },
                "umd_rule": { "type": "string", "minLength": 20 }
              }
            },
            "qualification_rule": { "type": "string", "minLength": 40 }
          }
        }
      }
    }
  ],
  "$defs": {
    "resultJsIgnore": { "type": "object", "$ref": "#/$defs/ignoreRule", "properties": { "owning_file": { "const": "packages/core/fp/result/.gitignore" }, "rule": { "const": "src/**/*.js" } } },
    "resultDtsIgnore": { "type": "object", "$ref": "#/$defs/ignoreRule", "properties": { "owning_file": { "const": "packages/core/fp/result/.gitignore" }, "rule": { "const": "src/**/*.d.ts" } } },
    "resultDtsMapIgnore": { "type": "object", "$ref": "#/$defs/ignoreRule", "properties": { "owning_file": { "const": "packages/core/fp/result/.gitignore" }, "rule": { "const": "src/**/*.d.ts.map" } } },
    "notesIgnore": { "type": "object", "$ref": "#/$defs/ignoreRule", "properties": { "owning_file": { "const": ".gitignore" }, "rule": { "const": "notes/" } } },
    "platformCandidatesIgnore": { "type": "object", "$ref": "#/$defs/ignoreRule", "properties": { "owning_file": { "const": ".gitignore" }, "rule": { "const": "platform/candidates/" } } },
    "resultsafeCandidatesIgnore": { "type": "object", "$ref": "#/$defs/ignoreRule", "properties": { "owning_file": { "const": ".gitignore" }, "rule": { "const": ".resultsafe-candidates/" } } },
    "ignoreRule": {
      "type": "object", "additionalProperties": false, "required": ["owning_file", "rule"],
      "properties": { "owning_file": { "type": "string" }, "rule": { "type": "string" } }
    },
    "atomicEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parent_run_id", "child_run_id", "child_kind", "child_status", "evidence_artifact_path", "evidence_artifact_sha256", "promotion_blocker"],
      "properties": {
        "parent_run_id": { "$ref": "urn:uuid:01a01af6-97ff-7818-8133-9dd18b7e2431" },
        "child_run_id": { "$ref": "urn:uuid:01a01af6-97ff-7818-8133-9dd18b7e2431" },
        "child_kind": { "const": "core-modularity" },
        "child_status": { "const": "PASS" },
        "evidence_artifact_path": { "type": "string", "pattern": "^\\.resultsafe-candidates/.+/CORE-MODULARITY-EVIDENCE\\.json$" },
        "evidence_artifact_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "promotion_blocker": { "const": "DIRTY_OR_UNCOMMITTED_SOURCE" }
      }
    }
  },
  "unevaluatedProperties": false
}
