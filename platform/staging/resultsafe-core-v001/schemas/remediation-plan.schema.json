{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:uuid:01a01d86-7c28-7c7a-b957-1e84d391418b",
  "title": "ResultSafe remediation plan",
  "type": "object",
  "allOf": [
    { "$ref": "urn:uuid:01a01af6-9801-778a-89d8-17777b859f3b" },
    {
      "type": "object",
      "properties": {
        "document_key": { "const": "remediation-plan" },
        "document_type": { "const": "execution_plan" },
        "schema_ref": { "const": "urn:uuid:01a01d86-7c28-7c7a-b957-1e84d391418b" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["plan_status", "source_scope", "task_count", "status_policy", "tasks"],
          "properties": {
            "plan_status": { "const": "IN_PROGRESS" },
            "source_scope": { "type": "array", "items": { "type": "string", "minLength": 10 }, "minItems": 2, "uniqueItems": true },
            "task_count": { "const": 23 },
             "status_policy": { "const": "QUALIFIED_LOCAL_SNAPSHOT and PASS_LOCAL_ATOMIC require cited current executable atomic evidence and do not imply release approval, promotion, or publication." },
            "tasks": {
              "type": "array",
              "minItems": 23,
              "maxItems": 23,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["task_id", "task_key", "priority", "status", "objective", "finding_refs", "depends_on_task_ids", "acceptance_gates"],
                "properties": {
                  "task_id": { "$ref": "urn:uuid:01a01af6-97ff-7818-8133-9dd18b7e2431" },
                  "task_key": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
                  "priority": { "enum": ["P0", "P1", "P2"] },
                   "status": { "enum": ["PLANNED", "IN_PROGRESS", "BLOCKED", "NOT_VERIFIED", "QUALIFIED_LOCAL_SNAPSHOT"] },
                  "objective": { "type": "string", "minLength": 20 },
                  "finding_refs": { "type": "array", "items": { "$ref": "urn:uuid:01a01af6-9800-71cc-8102-365165200d36" }, "uniqueItems": true },
                  "depends_on_task_ids": { "type": "array", "items": { "$ref": "urn:uuid:01a01af6-97ff-7818-8133-9dd18b7e2431" }, "uniqueItems": true },
                  "acceptance_gates": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["gate_key", "criterion", "status"],
                       "properties": {
                         "gate_key": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
                         "criterion": { "type": "string", "minLength": 15 },
                         "status": { "enum": ["NOT_EXECUTED", "BLOCKED", "PASS_LOCAL_ATOMIC"] },
                         "blocker": { "type": "string", "minLength": 20 },
                         "atomic_evidence": { "$ref": "#/$defs/atomicEvidence" }
                       },
                       "allOf": [
                         { "if": { "properties": { "status": { "const": "PASS_LOCAL_ATOMIC" } } }, "then": { "required": ["atomic_evidence"], "properties": { "atomic_evidence": { "$ref": "#/$defs/atomicEvidence" } } } },
                         { "if": { "properties": { "status": { "const": "BLOCKED" } } }, "then": { "required": ["blocker"], "properties": { "blocker": { "type": "string", "minLength": 20 } } } }
                       ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "atomicEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parent_run_id", "child_run_id", "child_kind", "child_status", "evidence_artifact_path", "evidence_artifact_sha256", "promotion_blocker"],
      "properties": {
        "parent_run_id": { "$ref": "urn:uuid:01a01af6-97ff-7818-8133-9dd18b7e2431" },
        "child_run_id": { "$ref": "urn:uuid:01a01af6-97ff-7818-8133-9dd18b7e2431" },
        "child_kind": { "enum": ["canonical-scenario", "cross-language-matrix", "core-modularity", "cause-exit-exact-artifacts", "json-codec", "effect-adapter", "storage"] },
        "child_status": { "const": "PASS" },
        "evidence_artifact_path": { "type": "string", "pattern": "^\\.resultsafe-candidates/.+/[A-Z-]+-EVIDENCE\\.json$" },
        "evidence_artifact_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "promotion_blocker": { "const": "DIRTY_OR_UNCOMMITTED_SOURCE" }
      }
    }
  },
  "unevaluatedProperties": false
}
