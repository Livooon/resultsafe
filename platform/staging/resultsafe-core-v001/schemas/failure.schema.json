{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:uuid:01a01d13-3258-7290-918b-58b436a80180",
  "title": "ResultSafe portable Failure 1.0.0",
  "$ref": "#/$defs/failure",
  "$defs": {
    "jsonValue": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string" },
        { "type": "array", "items": { "$ref": "#/$defs/jsonValue" } },
        { "type": "object", "additionalProperties": { "$ref": "#/$defs/jsonValue" } }
      ]
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "category": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL"] },
        "retryability": { "enum": ["UNKNOWN", "NEVER", "CONDITIONAL", "ALWAYS"] }
      },
      "minProperties": 1
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "code"],
      "properties": {
        "schema_version": { "const": "1.0.0" },
        "code": { "type": "string", "format": "uri" },
        "message": { "type": "string" },
        "message_key": { "type": "string", "minLength": 1 },
        "message_args": { "type": "object", "additionalProperties": { "$ref": "#/$defs/jsonValue" } },
        "details": { "$ref": "#/$defs/jsonValue" },
        "causes": { "type": "array", "items": { "$ref": "#/$defs/failure" }, "maxItems": 64 },
        "classification": { "$ref": "#/$defs/classification" },
        "metadata": { "type": "object", "additionalProperties": { "$ref": "#/$defs/jsonValue" } },
        "extensions": { "type": "object", "propertyNames": { "format": "uri" }, "additionalProperties": { "$ref": "#/$defs/jsonValue" } }
      }
    }
  }
}
