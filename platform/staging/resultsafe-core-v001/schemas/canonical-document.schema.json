{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:uuid:01a01af6-9801-778a-89d8-17777b859f3b",
  "title": "ResultSafe canonical document envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_id",
    "document_ref",
    "document_key",
    "document_type",
    "document_revision",
    "schema_ref",
    "title",
    "summary",
    "lifecycle",
    "created_at",
    "updated_at",
    "payload"
  ],
  "properties": {
    "document_id": { "$ref": "urn:uuid:01a01af6-97ff-7818-8133-9dd18b7e2431" },
    "document_ref": { "type": "string", "pattern": "^urn:uuid:[0-9a-f-]{36}$" },
    "document_key": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "document_type": {
      "enum": [
        "entrypoint",
        "work",
        "policy",
        "registry",
        "contract_ir",
        "requirement_catalog",
        "decision_catalog",
        "finding_catalog",
        "risk_catalog",
        "standards_catalog",
        "contract_catalog",
        "projection_catalog",
        "package_family_catalog",
        "scenario_catalog",
        "graph",
        "traceability",
        "evidence_catalog",
        "validation_plan",
        "qualification_receipt",
        "compatibility_catalog",
        "schema_index",
        "integrity_manifest",
        "relational_schema",
        "sqlite_profile",
        "execution_plan",
        "conformance_matrix",
        "architecture_audit",
        "failure_model",
        "cause_model",
        "exit_model",
        "cause_exit_conformance_matrix",
        "optional_integration_catalog"
      ]
    },
    "document_revision": { "type": "integer", "minimum": 0 },
    "schema_ref": { "$ref": "urn:uuid:01a01af6-9800-71cc-8102-365165200d36" },
    "title": { "type": "string", "minLength": 3 },
    "summary": { "type": "string", "minLength": 20 },
    "lifecycle": { "enum": ["DRAFT", "REVIEW", "APPROVED", "SUPERSEDED"] },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "payload": { "type": "object" }
  }
}
