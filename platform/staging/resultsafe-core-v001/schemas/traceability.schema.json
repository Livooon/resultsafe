                  "relation": { "enum": ["EVIDENCES", "IDENTIFIES", "ADDRESSED_BY", "GOVERNS", "HAS_SCENARIO", "SPECIFIED_BY", "VERIFIED_BY", "PROJECTED_AS", "PLANNED_FOR", "IMPLEMENTED_BY", "MITIGATES", "MIGRATES", "RESPONDS_TO"] },
