{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:uuid:01a01f0a-da09-7590-9665-b8841a81fe96",
  "title": "ResultSafe portable Exit 1.0.0",
  "$comment": "T and Cause E are represented by explicit caller-supplied portable codecs. Failure with Empty cause is valid.",
