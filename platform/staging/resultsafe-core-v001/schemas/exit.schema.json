    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag", "cause"],
      "properties": {
        "tag": { "const": "Failure" },
        "cause": { "$ref": "urn:uuid:01a01f0a-da08-7b85-87bc-dea758e0db27" }
      }
    }
  ],
  "$defs": {
    "jsonValue": {
      "oneOf": [
