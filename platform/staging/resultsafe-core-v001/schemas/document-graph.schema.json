{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:uuid:01a01af6-9807-7522-b0e8-557d6f1d7bfd",
  "title": "ResultSafe document graph",
  "type": "object",
  "allOf": [
    { "$ref": "urn:uuid:01a01af6-9801-778a-89d8-17777b859f3b" },
    {
      "type": "object",
      "properties": {
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["nodes", "edges"],
          "properties": {
            "nodes": { "type": "array", "items": { "$ref": "urn:uuid:01a01af6-9800-71cc-8102-365165200d36" }, "minItems": 1, "uniqueItems": true },
            "edges": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["source_ref", "relation", "target_ref"],
                "properties": {
                  "source_ref": { "$ref": "urn:uuid:01a01af6-9800-71cc-8102-365165200d36" },
                  "relation": { "enum": ["READS_BEFORE", "GOVERNS", "VALIDATES", "DERIVES", "IMPLEMENTS", "EVIDENCES"] },
                  "target_ref": { "$ref": "urn:uuid:01a01af6-9800-71cc-8102-365165200d36" }
                }
              }
            }
          }
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
