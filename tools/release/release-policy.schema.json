{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResultSafe release policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "transitionState", "baseBranch", "packages", "calculatedReleaseAllowlist"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "transitionState": { "enum": ["PENDING", "APPLIED_LOCAL"] },
    "baseBranch": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+$" },
    "calculatedReleaseAllowlist": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "directory", "currentVersion", "pendingVersion", "bump"],
        "properties": {
          "name": { "const": "@resultsafe/core-fp-result" },
          "directory": { "const": "packages/core/fp/result" },
          "currentVersion": { "const": "0.2.1" },
          "pendingVersion": { "const": "0.3.0" },
          "bump": { "const": "minor" }
        }
      }
    },
    "packages": {
      "type": "object",
      "additionalProperties": false,
      "required": ["@resultsafe/core-fp-result"],
      "properties": {
        "@resultsafe/core-fp-result": {
          "type": "object",
          "additionalProperties": false,
          "required": ["directory", "currentVersion", "pendingVersion", "allowedBumps", "publicApiPaths"],
          "properties": {
            "directory": { "const": "packages/core/fp/result" },
            "currentVersion": { "const": "0.2.1" },
            "pendingVersion": { "const": "0.3.0" },
            "allowedBumps": { "const": ["minor"] },
            "publicApiPaths": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+$" }
            }
          }
        }
      }
    }
  }
}
