{
  "name": "@resultsafe/core-fp-result",
  "version": "0.3.0",
  "description": "Functional Result type for TypeScript with explicit error handling (Rust-style). Zero dependencies, tree-shakable, AI-friendly.",
  "author": {
    "name": "Denis Savasteev",
    "url": "https://github.com/resultsafe"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "latest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/resultsafe/resultsafe.git",
    "directory": "packages/core/fp/result"
  },
  "bugs": {
    "url": "https://github.com/resultsafe/resultsafe/issues"
  },
  "homepage": "https://github.com/resultsafe/resultsafe/tree/main/packages/core/fp/result#readme",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "clean:dist": "rimraf dist .tsbuildinfo",
    "generate:exports": "node ./__scripts__/public-module-registry.mjs --write",
    "check:exports": "node ./__scripts__/public-module-registry.mjs --check",
    "prebuild:all": "pnpm run check:exports",
    "prebuild:types": "pnpm run validate:ai-json",
    "build:types": "tsc -b ./config/tsconfig.build.types.json --force",
    "build:esm": "vite build --config ./config/vite.config.build.esm.ts",
    "build:cjs": "vite build --config ./config/vite.config.build.cjs.ts && node ./__scripts__/build/write-cjs-package-json.mjs",
    "build:umd": "vite build --config ./config/vite.config.build.umd.ts",
    "prepare:dist:publish": "node ./__scripts__/build/prepare-dist-publish.mjs",
    "check:release:artifacts": "node ./__scripts__/build/validate-release-artifacts.mjs",
    "check:release:pack": "npm pack --dry-run ./dist",
    "check:release:smoke": "node ./__scripts__/build/smoke-packed-package.mjs",
    "build:all": "pnpm run clean:dist && pnpm run build:esm && pnpm run build:cjs && pnpm run build:umd && pnpm run build:types",
    "build:release": "pnpm run build:all && pnpm run prepare:dist:publish",
    "verify:release": "pnpm run build:release && pnpm run check:release:artifacts && pnpm run check:release:pack && pnpm run check:release:smoke",
    "docs:api:clean": "rimraf docs/api",
    "docs:api:generate": "typedoc --options typedoc.json --out docs/api",
    "docs:api:mirror": "node ./__scripts__/docs/mirror-typedoc-api.mjs",
    "docs:api": "pnpm run docs:api:generate && pnpm run docs:api:mirror",
    "docs:api:check": "typedoc --options typedoc.json --emit none",
    "docs:api:all": "pnpm run docs:api:clean && pnpm run docs:api && pnpm run docs:api:check && pnpm run test",
    "test": "vitest run --config ./config/vitest.config.ts",
    "test:coverage": "vitest run --config ./config/vitest.config.ts --coverage",
    "test:examples": "vitest run --config ./config/vitest.config.examples.ts",
    "test:examples:watch": "vitest --config ./config/vitest.config.examples.ts",
    "typecheck:examples": "tsc --noEmit -p ./tsconfig.examples.json",
    "typecheck:contracts": "tsc --noEmit -p ./config/tsconfig.contracts.json",
    "lint": "eslint . --ext .ts,.tsx --config config/eslint.config.mjs",
    "lint:fix": "eslint . --ext .ts,.tsx --config config/eslint.config.mjs --fix",
    "lint:examples": "eslint __examples__/**/*.ts --config config/eslint.config.examples.mjs",
    "validate:ai-json": "node ./__scripts__/validate-ai-json.js",
    "validate:examples": "pnpm run validate:ai-json && pnpm run lint:examples && pnpm run typecheck:examples",
    "tasks:list": "type __examples__\\IMPROVEMENT_TASKS.md",
    "prepublishOnly": "pnpm run verify:release && pnpm run validate:examples",
    "npm:publish:dry": "pnpm run verify:release && npm publish ./dist --dry-run --access public",
    "npm:publish:public": "npm publish ./dist --access public --provenance"
  },
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "browser": "dist/umd/resultsafe-core-fp-result.umd.js",
  "types": "dist/types/index.d.ts",
